# Optional. Docker Compose sets local defaults and does not require this file.
# Production values are GitHub Actions secrets.

# Oskari database. Inside Compose the host name is db and the host port is 5433.
DB_HOST=db
DB_PORT=5432
DB_NAME=oskaridb
DB_USER=oskari
DB_PASSWORD=oskari

# Optional HTTP basic auth in front of the map. Leave both empty for local use.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# GeoServer admin and the database GeoServer reads.
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=db_dev
POSTGRES_USER=db_dev_user
POSTGRES_PASSWORD=DevPassword

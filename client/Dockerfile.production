# Multi-stage build for client production
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies needed for building)
RUN npm ci

# Build argument for Cesium Ion token (needed at build time for webpack)
ARG CESIUM_ION_TOKEN

# Copy source code
COPY . .

# Set environment variable AFTER copying source to override any .env files
ENV CESIUM_ION_TOKEN=${CESIUM_ION_TOKEN}

# Build the application
RUN npm run build

# Production stage - serve with nginx
FROM nginx:alpine

# Install openssl for APR1 password hashing
RUN apk add --no-cache openssl

# Copy built files from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy entrypoint script to generate htpasswd at runtime
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose port 8080
EXPOSE 8080

# Health check (avoid auth by hitting /healthz)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/healthz || exit 1

# Use entrypoint to setup Basic Auth then start nginx
ENTRYPOINT ["/docker-entrypoint.sh"]

# Multi-stage build for client production
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies needed for building)
RUN npm ci

# Copy source code
COPY . .

# Build argument for Cesium Ion token (needed at build time for webpack)
ARG CESIUM_ION_TOKEN
ENV CESIUM_ION_TOKEN=${CESIUM_ION_TOKEN}

# Build the application
RUN npm run build

# Production stage - serve with nginx
FROM nginx:alpine

# Install envsubst for dynamic configuration
RUN apk add --no-cache gettext

# Copy built files from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Create startup script that substitutes environment variables
COPY <<'EOF' /docker-entrypoint.sh
#!/bin/sh
set -e

# Default values if environment variables are not set
API_SERVER_URL=${API_SERVER_URL:-"http://maapallo-server:3003"}
GEOSERVER_URL=${GEOSERVER_URL:-"http://maapallo-geoserver:8080/geoserver"}

# Create nginx config from template
cat > /etc/nginx/conf.d/default.conf << NGINXEOF
server {
    listen 8080;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to backend server
    location /api/ {
        proxy_pass ${API_SERVER_URL};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Proxy GeoServer calls to GeoServer container
    location /geoserver/ {
        proxy_pass ${GEOSERVER_URL}/;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Handle SPA routing - try files, then fallback to index.html
    location / {
        try_files \$uri \$uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)\$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip compression
    gzip on;
    gzip_types text/css application/javascript application/json text/javascript;
}
NGINXEOF

# Start nginx
exec nginx -g 'daemon off;'
EOF

RUN chmod +x /docker-entrypoint.sh

# Set proper ownership for nginx user (which already exists in nginx:alpine)
RUN chown -R nginx:nginx /etc/nginx/conf.d && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown nginx:nginx /docker-entrypoint.sh

# Switch to non-root user
USER nginx

# Expose port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

# Start nginx with dynamic configuration
CMD ["/docker-entrypoint.sh"]

# Multi-stage build for client production
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies needed for building)
RUN npm ci

# Copy source code
COPY . .

# Build argument for Cesium Ion token (needed at build time for webpack)
ARG CESIUM_ION_TOKEN
ENV CESIUM_ION_TOKEN=${CESIUM_ION_TOKEN}

# Build the application
RUN npm run build

# Production stage - serve with nginx
FROM nginx:alpine

# Copy built files from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 8080
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

# Use default nginx command
CMD ["nginx", "-g", "daemon off;"]
